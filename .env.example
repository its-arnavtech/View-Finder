# Copy this file to .env and fill in the token. .env is gitignored; never
# commit a real token. A leaked bot token lets anyone act as your bot.

# The View Finder Discord bot's own token, from the Discord developer portal.
# This must be a SEPARATE application from any other bot you run - two
# processes cannot share one token, and Discord will disconnect both if they
# try. See the "Discord bot" section of README.md for how to create it.
DISCORD_BOT_TOKEN=

# --- Optional safeguards. The defaults are sensible; change only if needed. ---

# Largest attachment the bot will accept, in MB. Discord's own cap for
# non-Nitro uploads is 25 MB, so this mostly matters on boosted servers.
VIEWFINDER_MAX_ATTACHMENT_MB=50

# Largest download the bot will pull from a link, in MB. Higher than the
# attachment cap because a linked video is normally larger than a photo.
VIEWFINDER_MAX_DOWNLOAD_MB=200

# Reject linked videos longer than this many seconds before downloading them.
VIEWFINDER_MAX_VIDEO_SECONDS=600

# --- Unrelated to the bot; used by the CLI. ---

# Use a location encoder other than the bundled fine-tuned one. Leave blank to
# use the default. Pass --use-stock-geoclip to fall back to GeoCLIP's original
# weights instead.
VIEWFINDER_LOCATION_ENCODER=
