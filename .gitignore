# === Secrets / credentials — never commit ===
# Real Mapillary access token lives here; only .env.example (placeholder) is tracked.
.env
.env.*
!.env.example
*.token
secrets.*
credentials.*

# === Python bytecode / caches ===
__pycache__/
*.py[cod]
*$py.class
*.pyo

# === Virtual environments ===
.venv/
venv/
env/
ENV/

# === Test / tooling caches ===
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# === Airflow runtime (WSL2 native run) ===
.airflow/
airflow_home/
airflow-*/
*.db-wal
*.db-shm

# === Pipeline data & build artifacts ===
# Raw scraped images, SQLite catalogs, and intermediate parquet stay out (large,
# regenerable, third-party imagery). Built gallery artifacts (FAISS index +
# metadata + manifest + reports) ARE committed so the retrieval predictor
# reproduces exactly on a fresh clone; they contain no raw images.
gallery-pipeline/data/*
!gallery-pipeline/data/.gitkeep
!gallery-pipeline/data/*/
gallery-pipeline/data/*/*
!gallery-pipeline/data/*/gallery/
!gallery-pipeline/data/*/gallery/**

# === ML model caches / weights ===
*.pth
*.safetensors
.cache/
huggingface/

# === Local prediction outputs (regenerated per run) ===
# Existing committed sample outputs stay tracked; this ignores new ad-hoc ones.
/*_viewfinder.json
!alsk_viewfinder.json
!images_viewfinder.json
!IMG_6790_viewfinder.json

# === Scratch / temp ===
scratchpad/
tmp/
*.tmp
*.part
*.log

# === OS / editor cruft ===
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
