# === Secrets / credentials — never commit ===
# Real Mapillary access token lives here; only .env.example (placeholder) is tracked.
.env
.env.*
!.env.example
*.token
secrets.*
credentials.*

# === Python bytecode / caches ===
__pycache__/
*.py[cod]
*$py.class
*.pyo

# === Virtual environments ===
.venv/
venv/
env/
ENV/

# === Test / tooling caches ===
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# === Airflow runtime (WSL2 native run) ===
.airflow/
airflow_home/
airflow-*/
*.db-wal
*.db-shm

# === Pipeline data & build artifacts ===
# Raw scraped images, SQLite catalogs, and intermediate parquet stay out (large,
# regenerable, third-party imagery). Built gallery artifacts (FAISS index +
# metadata + manifest + reports) ARE committed so the retrieval predictor
# reproduces exactly on a fresh clone; they contain no raw images.
gallery-pipeline/data/*
!gallery-pipeline/data/.gitkeep
!gallery-pipeline/data/*/
gallery-pipeline/data/*/*
!gallery-pipeline/data/*/gallery/
!gallery-pipeline/data/*/gallery/**

# Fully local GeoNames / Wikimedia / OSM evidence corpus (20-50+ GB).
local-data/

# === ML model caches / weights ===
*.pth
*.safetensors
*.pb
.cache/
huggingface/

# Third-party model binaries are fetched at runtime, never vendored. The EAST
# text detector (~92 MB) is downloaded on demand by viewfinder/text_removal.py
# from its upstream release, so committing it would only bloat the repo and
# redistribute someone else's weights.
models/

# === Local prediction outputs (regenerated per run) ===
# Existing committed sample outputs stay tracked; this ignores new ad-hoc ones.
/*_viewfinder.json
!alsk_viewfinder.json
!images_viewfinder.json
!IMG_6790_viewfinder.json

# === images/ : local image inputs and datasets ===
# Only the small committed test fixtures are tracked. Everything else placed here
# (the Im2GPS benchmark set, ad-hoc inputs, image3.png) stays local and out of git.
images/*
!images/alsk.png
!images/images.png
!images/IMG_6790.png

# === Benchmark datasets ===
# Downloaded third-party datasets (large, their own licenses) stay local. The
# build_manifest.py script and inventory notes are small and may be committed.
benchmark-data/kaggle/
benchmark-data/manifest.csv
benchmark-data/manifest.parquet

# === GeoCLIP fine-tuning outputs ===
# Location-encoder checkpoints are already covered by *.pth above. Per-run logs,
# split manifests, summaries, and measurement dumps are regenerated by each run
# and stay local; the finetune/ scripts and README are tracked.
finetune/work/
finetune/checkpoints/
finetune/*_console.txt
finetune/vram_probe.json
finetune/throughput.json

# === Third-party image archives ===
# Downloaded benchmark/test image sets carry their own per-item licenses (the
# Im2GPS 2k set is Flickr imagery) and run to hundreds of MB, well past GitHub's
# 100 MB per-file limit. They stay local; benchmark-data/INVENTORY.md records
# provenance so a fresh clone knows what to fetch.
*.zip
*.tar
*.tar.gz
*.7z

# Loose image inputs dropped at the repo root. The tracked test fixtures live in
# images/ (see above); anything left at the top level is ad-hoc scratch.
/*.jpg
/*.jpeg
/*.png
/*.bmp
/*.webp

# === Scratch / temp ===
scratchpad/
tmp/
*.tmp
# Stray file produced by a mistyped CLI flag (e.g. `... -- --input`).
/--input
*.part
*.log

# === OS / editor cruft ===
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
